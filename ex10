using System;

class Pessoa
{
    public double Peso { get; set; }
    public double Altura { get; set; }

    public double CalcularRelacao()
    {
        return Peso / (Altura * Altura);
    }

    public string ClassificarPeso()
    {
        double relacao = CalcularRelacao();

        if (relacao < 20)
        {
            return "Abaixo do peso";
        }
        else if (relacao < 25)
        {
            return "Peso ideal";
        }
        else
        {
            return "Acima do peso";
        }
    }
}

class Program
{
    static void Main()
    {
        Pessoa pessoa = new Pessoa();

        Console.Write("Digite o peso: ");
        pessoa.Peso = double.Parse(Console.ReadLine());

        Console.Write("Digite a altura: ");
        pessoa.Altura = double.Parse(Console.ReadLine());

        Console.WriteLine(
            "Relação: " + pessoa.CalcularRelacao().ToString("F2"));

        Console.WriteLine(pessoa.ClassificarPeso());
    }
}
